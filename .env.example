# Web
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# AI service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_DATA_DIR=./data
AI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_MAX_UPLOAD_MB=25
AI_RATE_LIMIT_PER_MINUTE=120
AI_REQUEST_LOG_ENABLED=true

# Optional SiliconFlow DeepSeek chat endpoint.
# When empty, PaperMind falls back to grounded extractive answers.
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
